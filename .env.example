SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
JPA_DDL_AUTO=update
JPA_OPEN_IN_VIEW=false
JPA_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
JPA_FORMAT_SQL=true
