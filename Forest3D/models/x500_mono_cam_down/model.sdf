<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="x500_mono_cam_down">
    <self_collide>false</self_collide>

    <include merge="true">
      <uri>model://x500</uri>
    </include>

    <include merge="true">
      <uri>model://mono_cam</uri>
      <name>mono_cam</name>
      <pose>0 0 -0.20 0 1.57079632679 0</pose>
    </include>

    <joint name="CameraJoint" type="revolute">
      <parent>base_link</parent>
      <child>camera_link</child>
      <pose relative_to="base_link">0 0 -0.20 0 1.57079632679 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.57079632679</lower>
          <upper>0</upper>
          <effort>8</effort>
          <velocity>6</velocity>
        </limit>
        <dynamics>
          <damping>0.2</damping>
        </dynamics>
      </axis>
    </joint>

    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>CameraJoint</joint_name>
      <sub_topic>command/camera_pitch</sub_topic>
      <p_gain>2.5</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>0.05</d_gain>
      <i_max>0</i_max>
      <i_min>0</i_min>
      <cmd_max>2.0</cmd_max>
      <cmd_min>-2.0</cmd_min>
    </plugin>

    <link name="lidar_link">
      <pose relative_to="base_link">0 0 0.18 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name="lidar_visual">
        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>0.035</length>
          </cylinder>
        </geometry>
      </visual>
      <sensor name="lidar" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>lidar</topic>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265359</min_angle>
              <max_angle>3.14159265359</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.20</min>
            <max>2000.0</max>
            <resolution>0.05</resolution>
          </range>
        </lidar>
      </sensor>
      <sensor name="lidar_3d" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <topic>/lidar_3d</topic>
        <lidar>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265359</min_angle>
              <max_angle>3.14159265359</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.52359877559</min_angle>
              <max_angle>0.52359877559</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.20</min>
            <max>60.0</max>
            <resolution>0.05</resolution>
          </range>
        </lidar>
      </sensor>
    </link>

    <joint name="LidarJoint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>
  </model>
</sdf>
