<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="x500_downward_camera">
    <self_collide>false</self_collide>
    <include merge="true">
      <uri>model://x500</uri>
    </include>

    <link name="downward_camera_link">
      <pose relative_to="base_link">0 0 -0.12 0 1.5708 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.00004</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00004</iyy>
          <iyz>0</iyz>
          <izz>0.00004</izz>
        </inertia>
      </inertial>
      <visual name="housing">
        <geometry>
          <box>
            <size>0.06 0.05 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.04 0.04 0.04 1</diffuse>
        </material>
      </visual>
      <visual name="lens">
        <pose>0.035 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.018</radius>
            <length>0.018</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.10 0.12 0.16 1</ambient>
          <diffuse>0.10 0.12 0.16 1</diffuse>
          <specular>0.8 0.8 0.9 1</specular>
        </material>
      </visual>
      <sensor name="downward_camera" type="camera">
        <gz_frame_id>downward_camera_link</gz_frame_id>
        <topic>/drone/downward_camera/image</topic>
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>300</far>
          </clip>
        </camera>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
      </sensor>
    </link>

    <joint name="downward_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>downward_camera_link</child>
    </joint>
  </model>
</sdf>
